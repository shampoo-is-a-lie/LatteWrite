{
  "name": "lattewrite",
  "version": "0.1.0",
  "description": "A beautiful, themeable, presentation-first word processor",
  "main": "out/main/index.js",
  "author": "shampoo-is-a-lie",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "predist": "bash scripts/fetch-whisper.sh",
    "web:dev": "vite -c web/vite.config.mjs",
    "web:build": "vite build -c web/vite.config.mjs",
    "dist": "electron-vite build && electron-builder --linux AppImage",
    "postdist": "mkdir -p ~/LatteWrite && for f in dist/*.AppImage; do b=$(basename \"$f\"); [ -f ~/LatteWrite/\"$b\" ] && mv -f ~/LatteWrite/\"$b\" ~/LatteWrite/\"${b%.AppImage}_old.AppImage\"; cp \"$f\" ~/LatteWrite/\"$b\"; done && echo \"Deployed to ~/LatteWrite\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/lora": "^5.1.0",
    "@fontsource/raleway": "^5.1.0",
    "@fontsource/source-serif-4": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "@huggingface/transformers": "^3.8.1",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-color": "^2.11.5",
    "@tiptap/extension-font-family": "^2.11.5",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/extension-text-style": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "adm-zip": "^0.5.17",
    "docx": "^9.0.3",
    "electron-store": "^8.2.0",
    "googleapis": "^144.0.0",
    "jszip": "^3.10.1",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "svelte": "^4.2.18",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.lattewrite.app",
    "productName": "LatteWrite",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "resources/icon.png"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      { "from": "resources/whisper", "to": "whisper" },
      { "from": "resources/icon.png", "to": "icon.png" }
    ]
  }
}
